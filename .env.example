# Copy to .env on the server and fill locally. Never commit .env or paste keys into chat.
# Shopify app client secret/shared secret, used to validate App Proxy signatures.
SHOPIFY_API_SECRET=
# Google AI Studio / Gemini Developer API key. Keep server-side only.
GEMINI_API_KEY=
# Recommended model is a benchmark starting point, not a final provider guarantee.
GEMINI_MODEL=gemini-nano-banana-2.1
PORT=8787
HOST=0.0.0.0
# Configure to match the actual hosting proxy chain; keep 0 unless your host requires otherwise.
TRUST_PROXY_HOPS=0
# One per request by design. Limits are guardrails; choose final limits after testing.
PREVIEW_MAX_PER_HOUR=3
JOB_TTL_MINUTES=15
MAX_IN_MEMORY_JOBS=20
